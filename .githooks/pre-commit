#!/bin/sh
# Impide commitear un JSON roto o un JavaScript que no compila.
# Activarlo una vez: git config core.hooksPath .githooks
set -e
python3 -c "import json,sys; json.load(open('data/viaje.json'))" || { echo "pre-commit: data/viaje.json no es JSON valido"; exit 1; }
for f in app.js sw.js; do
  node --check "$f" >/dev/null || { echo "pre-commit: $f no compila"; exit 1; }
done
for t in data/tracks/dia-*.json; do
  python3 -c "import json,sys; json.load(open('$t'))" || { echo "pre-commit: $t no es JSON valido"; exit 1; }
done
echo "pre-commit: JSON y JavaScript correctos"
