#!/bin/sh
# Impide commitear un JSON roto o un JavaScript que no compila, en cualquiera de los viajes.
# Activarlo una vez: git config core.hooksPath .githooks
set -e
python3 tools/validar.py || { echo "pre-commit: hay errores en los viajes (ver arriba)"; exit 1; }
for f in app.js sw.js; do
  node --check "$f" >/dev/null || { echo "pre-commit: $f no compila"; exit 1; }
done
echo "pre-commit: viajes, JSON y JavaScript correctos"
